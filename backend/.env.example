# Copy to .env and fill in real values. Never commit .env.
# Local development: leave DATABASE_URL unset to use SQLite.
# Production: set DATABASE_URL to your Postgres URL and JWT_SECRET to a
# long random string, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=
PORT=5000
CORS_ORIGINS=http://localhost:5173
